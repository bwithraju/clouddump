# CloudDump Environment Configuration
# Copy this file to .env and adjust variables as needed for local or Docker development:
#   cp .env.example .env

# ==========================================
# Server & API Configuration
# ==========================================
PORT=8080
ENVIRONMENT=development

# ==========================================
# Frontend Configuration
# ==========================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# ==========================================
# Storage & Chunking Engine
# ==========================================
# Default chunk size: 256 MB (268435456 bytes)
# For quick development/testing: set smaller, e.g., 2097152 (2 MB) or 5242880 (5 MB)
CHUNK_SIZE_BYTES=268435456
MAX_UPLOAD_WORKERS=4
STORAGE_ROOT=./storage
STORAGE_LOCAL_ROOT=./storage

# ==========================================
# Database (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=clouddump
DB_SSLMODE=disable
# Direct connection string override (optional):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/clouddump?sslmode=disable

# ==========================================
# Redis & Background Workers
# ==========================================
REDIS_ADDR=localhost:6379
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# Authentication & Security
# ==========================================
JWT_SECRET=super-secret-jwt-key-replace-in-production-min32chars
TOKEN_EXPIRY_HOURS=24

# ==========================================
# Google Drive Provider (Phase 16 - Optional)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/oauth/google/callback
