# CloudDump Environment Configuration

# Server
PORT=8080
ENVIRONMENT=development

# Storage & Chunking Configuration
# Default chunk size: 256 MB (268435456 bytes)
# For development/testing: set smaller e.g. 5242880 (5 MB) or 1048576 (1 MB)
CHUNK_SIZE_BYTES=268435456
MAX_UPLOAD_WORKERS=4
STORAGE_LOCAL_ROOT=./storage

# Database (PostgreSQL) - Phase 5+
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=clouddump
DB_SSLMODE=disable

# Redis & Background Workers - Phase 8+
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-replace-in-production-min32chars
TOKEN_EXPIRY_HOURS=24

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api
